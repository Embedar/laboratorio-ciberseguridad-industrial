[Unit]
Description=ModbusPal industrial lab (headless, isolated VMnet1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lab
Group=lab
WorkingDirectory=/opt/lab-plc
ExecStart=/usr/bin/java -Xms32m -Xmx128m -Djava.awt.headless=true -cp /opt/lab-plc/ModbusPal.jar:/opt/lab-plc ModbusPalHeadless
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
CacheDirectory=modbuspal-lab
CacheDirectoryMode=0750
Environment=XDG_CACHE_HOME=/var/cache/modbuspal-lab
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
Restart=no

[Install]
WantedBy=multi-user.target
